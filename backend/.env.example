DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=r2pconnect
DB_USERNAME=root
DB_PASSWORD=

# Application
APP_NAME="R2P Connect"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=https://r2papi.sunnyfex.com/backend/api.php
VITE_API_URL=https://r2papi.sunnyfex.com/backend/api.php

# Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# Paystack Integration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# Email (ZeptoMail)
ZEPTOMAIL_API_KEY=Zoho-enczapikey_xxxxxxxxxxxxx
MAIL_FROM_ADDRESS=noreply@r2pconnect.com
MAIL_FROM_NAME="R2P Connect"

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=deepseek

# Currency Exchange
EXCHANGE_RATE_API=https://api.exchangerate-api.com/v4/latest/USD

# File Storage
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE=52428800

# Session
SESSION_LIFETIME=1440

# CORS
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=debug
LOG_PATH=./logs
